# Copy to .env and fill in. Never commit .env.

# Model access. "auto" uses the Claude API when ANTHROPIC_API_KEY is set, otherwise heuristic-only.
# Options: auto, anthropic, bedrock, off
TAA_LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# For Amazon Bedrock (keeps candidate data inside Astrion's AWS account):
# TAA_LLM_PROVIDER=bedrock
# TAA_BEDROCK_REGION=us-east-1
TAA_SCORING_MODEL=claude-opus-5-5
TAA_DRAFTING_MODEL=claude-opus-5-5
TAA_SCORING_EFFORT=high
TAA_DRAFTING_EFFORT=medium
# Server-side refusal fallback on the Claude API (ignored on Bedrock)
TAA_LLM_FALLBACKS=true
# Cap on candidates sent to the model per search (the rest keep heuristic scores)
TAA_MAX_LLM_CANDIDATES=200
TAA_LLM_CONCURRENCY=4

# People Data Labs (optional, licensed person search; billed per record)
PDL_API_KEY=
TAA_PDL_MAX_RESULTS=25

# Storage. SQLite by default; Postgres via docker-compose.
TAA_DATABASE_URL=sqlite:///./data/taa.db
POSTGRES_PASSWORD=

# Access control. Use one:
#   1) an identity-aware proxy (Entra ID App Proxy, oauth2-proxy) that sets a user header
TAA_TRUSTED_USER_HEADER=
#   2) shared basic auth for a pilot
TAA_USERNAME=
TAA_PASSWORD=
# Signs form tokens. Set a long random value so forms survive restarts.
TAA_SECRET_KEY=

# Flags profiles older than this many days
TAA_STALE_AFTER_DAYS=180
